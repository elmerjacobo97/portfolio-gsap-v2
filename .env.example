# Copy to .env.local and fill in. Never commit .env.local.

# Resend - https://resend.com/api-keys
RESEND_API_KEY=

# Where contact form submissions land.
CONTACT_TO_EMAIL=

# Must be on a domain verified in Resend, otherwise sends are rejected.
CONTACT_FROM_EMAIL=

# Public - inlined into the client bundle. No secrets here.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CAL_LINK=
